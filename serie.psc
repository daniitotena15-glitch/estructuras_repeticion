Algoritmo serie
	Definir contaNum, cantiTermi, ter Como Entero
	Escribir "Este programa genera y calcula una serie de numeros los cuales son impares"
	Escribir ""
	Escribir "Ingrese la cantidad de numeros que desea que se muestren"
	leer  cantiTermi
	contaNum= 0
	ter= 1
	Repetir
		Escribir ter ","
		ter= ter + 2
		contaNum= contaNum +1
	Mientras Que (contaNum<cantiTermi)
	
FinAlgoritmo
